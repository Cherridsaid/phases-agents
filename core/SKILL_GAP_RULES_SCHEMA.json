{
  "$schema": "PHASES_SCHEMA_V1",
  "schema_id": "SKILL_GAP_RULES_SCHEMA",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "description",
    "rules"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "enum": [
        "SKILL_GAP_RULES"
      ]
    },
    "version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "required_facts",
          "capability",
          "severity",
          "reason_code"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "minLength": 1
          },
          "required_facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "blocking"
            ]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "NO_INSTALLED_SKILL_FOR_CAPABILITY"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
